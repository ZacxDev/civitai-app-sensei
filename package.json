{
  "name": "sensei",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Civitai Sensei — an AI research assistant App Block with chat, NSFW agent, and catalog search.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "dev:harness": "VITE_DEV_HARNESS=true vite --host localhost --port 5189",
    "dev:tunnel": "vite --host 127.0.0.1 --port 5186",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@civitai/app-sdk": "^0.31.0",
    "@civitai/blocks-react": "^0.39.0",
    "@civitai/components-react": "^0.3.0",
    "@civitai/theme": "^0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
